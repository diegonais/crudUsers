# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Admin SDK service account keys.
# Las credenciales administrativas deben vivir fuera del repositorio, pero
# estos patrones ayudan a evitar commits accidentales de claves privadas.
/service-account*.json
/*-firebase-adminsdk-*.json
/tools/firebase_admin/service-account*.json
/tools/firebase_admin/*-firebase-adminsdk-*.json
/tools/firebase_admin/.env
/tools/firebase_admin/node_modules/
